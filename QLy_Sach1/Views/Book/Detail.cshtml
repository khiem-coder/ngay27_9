@model QLy_Sach1.Models.Book

@{
    ViewData["Title"] = "Chi tiết sách";
}

<h2 class="my-3">Chi tiết sách</h2>

<div class="card col-md-6">
    <div class="card-body">
        <h5 class="card-title">Mã sách (Id): @Model.Id</h5>
        <p class="card-text"><strong>Tên sách:</strong> @Model.Name</p>
        <p class="card-text"><strong>Giá:</strong> $@Model.Price</p>
        <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
    </div>
</div>