@model QLy_Sach.Models.Book

@{
    ViewData["Title"] = "Thêm sách mới";
}

<h2>Thêm sách mới</h2>

<form asp-action="Create" method="post" class="mt-3" style="max-width: 400px;">
    <div class="mb-3">
        <label class="form-label">Tên sách (Name):</label>
        <input asp-for="Name" class="form-control" required />
    </div>
    
    <div class="mb-3">
        <label class="form-label">Giá (Price):</label>
        <input asp-for="Price" type="number" step="0.01" class="form-control" required />
    </div>

    <button type="submit" class="btn btn-success">Thêm sách</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>